@inherits LayoutComponentBase
@inject StaticAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <button class="btn btn-link" type="button" @onclick="LogoutAsync">Log out</button>
                </Authorized>
            </AuthorizeView>
        </div>

        @if (logoutErrorMessage is not null)
        {
            <div class="alert alert-danger mx-4 mt-3" role="alert">
                @logoutErrorMessage
            </div>
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private string? logoutErrorMessage;

    private async Task LogoutAsync()
    {
        logoutErrorMessage = null;

        try
        {
            await AuthenticationStateProvider.LogoutAsync();
            Navigation.NavigateTo("login", replace: true);
        }
        catch
        {
            logoutErrorMessage = "We couldn't finish logging you out because your browser session couldn't be cleared. Close this tab to finish signing out.";
        }
    }
}
